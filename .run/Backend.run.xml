<component name="ProjectRunConfigurationManager">
  <!--
    Runs the Ktor API against a local Postgres (start it with the "Postgres (Docker)"
    configuration first, or point DATABASE_URL somewhere else).

    Debugging works out of the box: ExternalSystemDebugServerProcess forks the Gradle
    JVM with the debug agent attached, so breakpoints in :backend hit normally.
  -->
  <configuration default="false" name="Backend" type="GradleRunConfiguration" factoryName="Gradle">
    <ExternalSystemSettings>
      <option name="executionName" />
      <option name="externalProjectPath" value="$PROJECT_DIR$" />
      <option name="externalSystemIdString" value="GRADLE" />
      <option name="scriptParameters" value="-Pktor.development=true" />
      <option name="taskDescriptions">
        <list />
      </option>
      <option name="taskNames">
        <list>
          <option value=":backend:run" />
        </list>
      </option>
      <option name="vmOptions" />
      <option name="env">
        <map>
          <entry key="APP_ENV" value="LOCAL" />
          <entry key="PORT" value="8080" />
          <entry key="DATABASE_URL" value="jdbc:postgresql://localhost:5432/splitfy" />
          <entry key="DATABASE_USER" value="splitfy" />
          <entry key="DATABASE_PASSWORD" value="splitfy" />
          <entry key="DATABASE_RUN_MIGRATIONS" value="true" />
          <entry key="JWT_SECRET" value="local-development-secret-do-not-use-in-production" />
          <entry key="JWT_ISSUER" value="http://localhost:8080" />
          <entry key="JWT_AUDIENCE" value="splitfy-mobile" />
          <!-- Cheaper hashing keeps local sign-up snappy; production uses the default 12. -->
          <entry key="BCRYPT_COST" value="10" />
        </map>
      </option>
    </ExternalSystemSettings>
    <ExternalSystemDebugServerProcess>true</ExternalSystemDebugServerProcess>
    <ExternalSystemReattachDebugProcess>true</ExternalSystemReattachDebugProcess>
    <DebugAllEnabled>false</DebugAllEnabled>
    <RunAsTest>false</RunAsTest>
    <method v="2" />
  </configuration>
</component>
