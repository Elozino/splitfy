# Copy to keystore.properties (gitignored) to sign release builds locally:
#
#   cp app/androidApp/keystore.properties.example app/androidApp/keystore.properties
#   ./gradlew :app:androidApp:bundleRelease
#
# Paths are relative to app/androidApp. Keep the keystore itself outside the
# repository, or at least never commit it (*.jks and *.keystore are gitignored).
# Environment variables take precedence over this file: ANDROID_KEYSTORE_PATH,
# ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD.

storeFile=/absolute/path/to/splitfy-upload.jks
storePassword=
keyAlias=upload
keyPassword=
