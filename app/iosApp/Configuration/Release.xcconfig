#include "Config.xcconfig"

// See Debug.xcconfig for why the URL is split in two.
API_SCHEME = https
API_HOST = splitfy.onrender.com

// Sign in with Apple. Needs a paid developer team with the capability enabled for
// the bundle id; personal teams cannot sign it, which is why Debug leaves it off.
// To try Apple sign-in in a Debug build, add this same line to Local.xcconfig.
CODE_SIGN_ENTITLEMENTS = iosApp/iosApp.entitlements

// Last, so a local override — a signing TEAM_ID, most likely — beats everything
// above it. Optional include: the file is gitignored.
#include? "Local.xcconfig"
