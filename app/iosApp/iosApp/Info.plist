<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The name under the home-screen icon. PRODUCT_NAME stays lowercase: it names the binary. -->
	<key>CFBundleDisplayName</key>
	<string>Splitfy</string>
	<key>CFBundleURLTypes</key>
	<array><dict><key>CFBundleURLSchemes</key><array><string>splitfy</string></array></dict></array>
	<!-- Assembled from API_SCHEME and API_HOST in the active .xcconfig. Read back
	     at launch by defaultApiBaseUrl() in ApiConfig.ios.kt. -->
	<key>ApiBaseUrl</key>
	<string>$(API_SCHEME)://$(API_HOST)</string>
	<!-- Read by platformGoogleClientId() in SocialSignIn.ios.kt. -->
	<key>GoogleIosClientId</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<!-- Read by startCrashReporting() in iOSApp.swift. Empty = reporting off. -->
	<key>SentryDsn</key>
	<string>$(SENTRY_DSN)</string>
	<!-- Lets FCM wake the app for silent data and badge updates. -->
	<key>UIBackgroundModes</key>
	<array><string>remote-notification</string></array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>This app requires camera access to scan QR codes for payments.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app requires photo library access to select QR codes for payments.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks Splitfy when App lock is on.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
