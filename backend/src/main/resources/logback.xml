<configuration>
    <!--
      One line per event, with the request's trace id so a user-reported failure
      maps to exactly one request. Structured JSON is the next step if/when logs
      are shipped to a central collector.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-no-trace}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="com.elozino.splitify" level="DEBUG"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <!-- Exposed logs every statement at DEBUG; far too noisy outside a debug session. -->
    <logger name="Exposed" level="INFO"/>
</configuration>
